# Resend API key — required for booking confirmation emails
# Sign up at https://resend.com (free tier: 3,000 emails/month)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# (Optional) Verified sender email address
# Defaults to onboarding@resend.dev which only works for your own Resend account email.
# For production, verify your domain at resend.com and set this to e.g.:
# RESEND_FROM_EMAIL=reservations@pinewoodtrailsrv.com
# RESEND_FROM_EMAIL=

# Set secrets in Cloudflare via:
#   wrangler secret put RESEND_API_KEY
#   wrangler secret put RESEND_FROM_EMAIL
